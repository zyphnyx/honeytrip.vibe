# Firebase Console → Project settings → Your apps → Web app → SDK config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Geoapify Places Discovery (Optional - ฟรี 100% ไม่ต้องผูกบัตรเครดิต)
# สมัครฟรีได้ที่ https://myprojects.geoapify.com/ (Free Plan 3,000 credits/day)
# สำคัญ: ห้ามใส่ prefix NEXT_PUBLIC_ เพราะใช้เฉพาะฝั่ง server-side route handler เท่านั้น
# หากไม่ใส่ตัวแปรนี้ ระบบจะปิดการค้นหาอัตโนมัติอย่างนุ่มนวล และเปิดให้เสนอสถานที่ด้วยตนเองได้ 100%
GEOAPIFY_API_KEY=

# Device Linking — server-only JSON จาก Firebase → Project settings → Service accounts
# ใส่ JSON ทั้งก้อนใน Vercel Environment Variable; ห้ามใช้ NEXT_PUBLIC_ หรือ commit key
FIREBASE_SERVICE_ACCOUNT_JSON=

# Unix milliseconds หลัง publish และตรวจสอบ identity guard rules แล้ว (ดู docs/device-linking.md)
# ห้ามย้อนเวลา cutoff นี้ เพราะ UID เก่าที่ไม่มี usage marker ยังพิสูจน์ว่าไม่มีข้อมูลไม่ได้
DEVICE_LINK_CLEAN_SINCE=

# Local demo emulators only (ห้ามเปิดใน Vercel/production; ต้องใช้ projectId demo-*)
# NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:19099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:18080
