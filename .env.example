# Firebase Console → Project settings → Your apps → Web app → SDK config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Geoapify Places Discovery (Optional - ฟรี 100% ไม่ต้องผูกบัตรเครดิต)
# สมัครฟรีได้ที่ https://myprojects.geoapify.com/ (Free Plan 3,000 credits/day)
# สำคัญ: ห้ามใส่ prefix NEXT_PUBLIC_ เพราะใช้เฉพาะฝั่ง server-side route handler เท่านั้น
# หากไม่ใส่ตัวแปรนี้ ระบบจะปิดการค้นหาอัตโนมัติอย่างนุ่มนวล และเปิดให้เสนอสถานที่ด้วยตนเองได้ 100%
GEOAPIFY_API_KEY=
