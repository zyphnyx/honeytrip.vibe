rules_version = '2';

// HoneyTrip — ไม่มี login: ใช้ Firebase Anonymous Auth + รหัสห้องที่เดายาก
// - ห้ามอ่านทั้ง collection rooms (list) → ไล่หาห้องคนอื่นไม่ได้
// - สมาชิกแก้/ลบได้เฉพาะ doc ของตัวเอง (doc id == auth.uid)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['title', 'emoji', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 60
        && request.resource.data.emoji is string
        && request.resource.data.emoji.size() <= 8
        && request.resource.data.createdAt is number;
      allow update: if false;
      allow delete: if signedIn();

      match /members/{memberId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.auth.uid == memberId
          && request.resource.data.keys().hasOnly([
            'name', 'emoji', 'status', 'durationMin', 'durationMax',
            'budgetMin', 'budgetMax', 'availableDates', 'origin',
            'transport', 'seats', 'prefs', 'note', 'updatedAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 30
          && request.resource.data.status in ['going', 'maybe', 'out']
          && request.resource.data.transport in ['own_car', 'need_ride', 'any']
          && request.resource.data.durationMin is number
          && request.resource.data.durationMax is number
          && request.resource.data.budgetMin is number
          && request.resource.data.budgetMax is number
          && request.resource.data.availableDates is list
          && request.resource.data.availableDates.size() <= 366
          && request.resource.data.prefs is list
          && request.resource.data.prefs.size() <= 20
          && request.resource.data.note.size() <= 200
          && request.resource.data.origin.size() <= 40;
        allow delete: if signedIn();
      }
    }
  }
}
